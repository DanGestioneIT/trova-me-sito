---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  titolo: string;
  descrizione: string;
  /**
   * Tiene la pagina fuori dai risultati di ricerca. Serve alla sola pagina di
   * errore: comparire fra i risultati per TROVA.ME manderebbe i visitatori su
   * un vicolo cieco. Le pagine vere non la impostano.
   */
  nonIndicizzare?: boolean;
  /**
   * La lingua della pagina. Il sito e' in inglese; l'unica eccezione e' la
   * versione italiana dell'informativa (`privacy/it/`), decisa dal proprietario
   * il 19 ottobre 2026. Testata e piede restano in inglese anche li', e lo
   * dichiarano, cosi' i lettori di schermo li pronunciano giusti.
   */
  lingua?: 'en' | 'it';
}

const { titolo, descrizione, nonIndicizzare = false, lingua = 'en' } = Astro.props;
const linguaCornice = lingua === 'en' ? undefined : 'en';

// L'indirizzo canonico dice ai motori di ricerca qual e' la versione ufficiale
// di questa pagina. Si ricava da `site` + `base` in astro.config.mjs.
const canonico = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161A" media="(prefers-color-scheme: dark)" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    {nonIndicizzare && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonico} />
    <meta property="og:site_name" content="TROVA.ME" />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonico} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header lingua={linguaCornice} />
    <main>
      <slot />
    </main>
    <Footer lingua={linguaCornice} />
  </body>
</html>
