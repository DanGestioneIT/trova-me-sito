---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path } from '../lib/paths';
import { altraLingua, type Lingua } from '../lib/lingue';
import '../styles/global.css';

interface Props {
  titolo: string;
  descrizione: string;
  /**
   * Tiene la pagina fuori dai risultati di ricerca. Serve alla sola pagina di
   * errore: comparire fra i risultati per TROVA.ME manderebbe i visitatori su
   * un vicolo cieco. Le pagine vere non la impostano.
   */
  nonIndicizzare?: boolean;
  /**
   * La lingua della pagina: inglese o italiano (decisione del proprietario del
   * 25 novembre 2026). Testata e piede parlano la stessa lingua della pagina.
   */
  lingua?: Lingua;
  /**
   * L'indirizzo della stessa pagina nell'altra lingua (es. 'app/minta/it/'):
   * la testata lo offre e i motori di ricerca lo leggono come versione tradotta.
   */
  altra?: string;
}

const { titolo, descrizione, nonIndicizzare = false, lingua = 'en', altra } = Astro.props;

// L'indirizzo canonico dice ai motori di ricerca qual e' la versione ufficiale
// di questa pagina. Si ricava da `site` + `base` in astro.config.mjs.
const canonico = new URL(Astro.url.pathname, Astro.site);
const tradotta = altra !== undefined ? new URL(path(altra), Astro.site) : undefined;
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161A" media="(prefers-color-scheme: dark)" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    {nonIndicizzare && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonico} />
    {tradotta && <link rel="alternate" hreflang={lingua} href={canonico} />}
    {tradotta && <link rel="alternate" hreflang={altraLingua(lingua)} href={tradotta} />}
    <meta property="og:site_name" content="TROVA.ME" />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonico} />
    <meta property="og:locale" content={lingua === 'it' ? 'it_IT' : 'en_US'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header lingua={lingua} altra={altra} />
    <main>
      <slot />
    </main>
    <Footer lingua={lingua} />
  </body>
</html>
