---
import { path } from '../lib/paths';

const anno = 2026;
---

<footer>
  <p>
    iPhone apps by Daniele Eric Carandente. &copy; {anno} TROVA.ME ·
    <a href={path('privacy/')}>Privacy</a>
  </p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--bordo);
  }

  p {
    max-width: var(--colonna-larga);
    margin: 0 auto;
    padding: 24px var(--margine);
    font-size: 14px;
    line-height: 20px;
    color: var(--tenue);
  }
</style>
