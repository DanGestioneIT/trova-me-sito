---
import { path } from '../lib/paths';

const anno = 2026;
---

<footer>
  <p>
    iPhone apps by Daniele Riccarand. &copy; {anno} TROVA.ME Milano
    &middot; <a href={path('privacy/')}>Privacy</a>
  </p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--bordo);
    margin-top: 32px;
  }

  p {
    max-width: var(--largo);
    margin: 0 auto;
    padding: 24px var(--margine);
    font-size: 14px;
    color: var(--tenue);
  }
</style>
