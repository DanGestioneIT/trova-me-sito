---
import { path } from '../lib/paths';
import { cornice, type Lingua } from '../lib/lingue';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const parole = cornice[lingua];

const anno = 2026;
---

<footer>
  <p>
    {parole.piede} &copy; {anno} TROVA.ME Milano
    &middot; <a href={path(parole.pathPrivacy)}>{parole.privacy}</a>
  </p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--bordo);
    margin-top: 32px;
  }

  p {
    max-width: var(--largo);
    margin: 0 auto;
    padding: 24px var(--margine);
    font-size: 14px;
    color: var(--tenue);
  }
</style>
