---
// L'elemento firma del sito: quello che e' stato DETTO, e quello che ne e'
// USCITO. Due caratteri, e il salto fra loro e' il prodotto.
//
// Perche' cosi' e non un'onda audio o un mockup: di queste app non esiste
// nemmeno uno screenshot, e inventarne uno sarebbe una bugia. Ma la
// trasformazione si puo' mostrare con la sola tipografia, e mostrarla con
// parole vere e' piu' onesto — e piu' preciso — di qualunque illustrazione.
//
// La riga detta e' minuscola e senza punteggiatura perche' e' cosi' che appare
// una trascrizione grezza. Non e' uno stile: e' la cosa.
interface Props {
  detto: string;
  ottenuto: string;
}

const { detto, ottenuto } = Astro.props;
---

<div class="firma">
  <p class="etichetta">Said</p>
  <p class="detto">{detto}</p>
  <p class="etichetta accento">Became</p>
  <p class="ottenuto">{ottenuto}</p>
</div>

<style>
  .firma {
    max-width: var(--colonna-larga);
    margin: 32px 0 48px;
  }

  .etichetta {
    margin: 0 0 8px;
    font-family: var(--detto);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tenue);
  }

  .accento {
    color: var(--accento);
  }

  .detto {
    max-width: var(--colonna);
    margin: 0 0 24px;
    font-family: var(--detto);
    font-size: 14px;
    line-height: 24px;
    color: var(--tenue);
  }

  .ottenuto {
    margin: 0;
    font-size: 28px;
    line-height: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .ottenuto {
      font-size: 36px;
      line-height: 40px;
    }
  }
</style>
