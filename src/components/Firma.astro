---
// Quello che e' stato detto, e quello che ne e' uscito. E' l'unica illustrazione
// possibile: di queste app non esiste uno screenshot, e inventarne uno sarebbe
// una bugia — ma la trasformazione si mostra con il carattere, che qui cambia
// davvero stato (Recursive, asse MONO).
//
// La riga detta e' minuscola e senza punteggiatura perche' e' cosi' che appare
// una trascrizione grezza. Non e' uno stile: e' la cosa.
interface Props {
  detto: string;
  ottenuto: string;
}

const { detto, ottenuto } = Astro.props;
---

<figure class="firma">
  <div class="riga">
    <p class="etichetta">Said</p>
    <p class="detto">“{detto}”</p>
  </div>
  <div class="freccia" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
      <path d="M12 4v16M6 14l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
  <div class="riga risultato">
    <p class="etichetta">Became</p>
    <p class="ottenuto">{ottenuto}</p>
  </div>
</figure>

<style>
  .firma {
    margin: 0;
    border: 1px solid var(--bordo);
    border-radius: 16px;
    background: var(--superficie);
    box-shadow: var(--ombra);
    overflow: hidden;
  }

  .riga {
    padding: 20px;
  }

  .risultato {
    border-top: 1px solid var(--bordo);
    background: var(--sfondo);
  }

  .detto {
    margin: 0;
    max-width: none;
    font-variation-settings: var(--parlato);
    font-size: 15px;
    line-height: 1.55;
    color: var(--tenue);
  }

  .ottenuto {
    margin: 0;
    max-width: none;
    font-size: clamp(1.25rem, 3.4vw, 1.75rem);
    line-height: 1.25;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .freccia {
    display: grid;
    place-items: center;
    height: 0;
    color: var(--accento);
  }

  .freccia svg {
    position: relative;
    z-index: 1;
    padding: 6px;
    border: 1px solid var(--bordo);
    border-radius: 999px;
    background: var(--sfondo);
    box-sizing: content-box;
  }

  @media (min-width: 48rem) {
    .riga {
      padding: 24px 28px;
    }
  }
</style>
