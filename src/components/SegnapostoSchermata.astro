---
// Riquadro che dichiara apertamente che la schermata non c'e' ancora.
// Il brief lo impone: gli screenshot veri arriveranno con un lavoro dedicato,
// e nel frattempo non si inventa nulla.
//
// Volutamente povero: un rettangolo con un bordo tratteggiato e una riga di
// testo. Se fosse bello sembrerebbe un'immagine, ed e' esattamente cio' che
// non deve sembrare.
interface Props {
  app: string;
}

const { app } = Astro.props;
---

<figure>
  <div class="riquadro" role="img" aria-label={`Screenshot of ${app} not available yet`}>
    <span>Screenshot coming</span>
  </div>
  <figcaption>Images of {app} will be published once the app is finished.</figcaption>
</figure>

<style>
  figure {
    max-width: var(--lettura);
    margin: 64px 0 0;
  }

  /* Compatto di proposito. Alto come una schermata di telefono, dominava la
     pagina e comunicava "sito incompleto" piu' forte di quanto le pagine
     raccontino le app: una dichiarazione onesta non deve gridare. */
  /* Non un telefono vuoto: una fascia che dichiara uno spazio riservato.
     Chiudere ogni pagina con quasi uno schermo bianco urlava "incompleto" e
     spegneva tutto quello che veniva prima. */
  .riquadro {
    display: grid;
    place-items: center;
    min-height: 120px;
    padding: 32px 24px;
    border: 2px dashed var(--tenue);
    color: var(--tenue);
    font-family: var(--detto);
    font-size: clamp(0.875rem, 2.4vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  figcaption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 20px;
    color: var(--tenue);
  }
</style>
