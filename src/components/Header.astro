---
import { path } from '../lib/paths';

const voci = [
  { testo: 'Minta', href: path('app/minta/') },
  { testo: 'Pronto', href: path('app/pronto/') },
  { testo: 'ClaudePal', href: path('app/claudepal/') },
];
---

<header>
  <nav aria-label="Main navigation">
    <a class="marchio" href={path('')}>TROVA.ME</a>
    <ul>
      {voci.map((voce) => (
        <li><a href={voce.href}>{voce.testo}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--bordo);
  }

  nav {
    max-width: var(--larghezza);
    margin: 0 auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .marchio {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--testo);
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    /* bersaglio comodo da toccare col pollice */
    display: inline-block;
    padding: 0.25rem 0;
  }
</style>
