---
import { path } from '../lib/paths';

const voci = [
  { testo: 'Minta', href: path('app/minta/') },
  { testo: 'Pronto', href: path('app/pronto/') },
  { testo: 'ClaudePal', href: path('app/claudepal/') },
];
---

<header>
  <div class="contenitore barra">
    <a class="marchio" href={path('')}>TROVA<span class="punto">.</span>ME</a>
    <nav aria-label="Main navigation">
      {voci.map((voce) => (
        <a href={voce.href}>{voce.testo}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Non appiccicata: e' una vetrina breve, non un'applicazione. Su telefono
     una barra fissa ruba lo spazio che serve al contenuto. */
  header {
    border-bottom: 1px solid var(--bordo);
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }

  .marchio {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--testo);
    text-decoration: none;
    white-space: nowrap;
  }

  .punto {
    color: var(--accento);
  }

  nav {
    display: flex;
    gap: 4px;
  }

  nav a {
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 15px;
    color: var(--tenue);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--testo);
    background: var(--superficie);
  }

  @media (max-width: 26rem) {
    nav a {
      padding: 8px 6px;
      font-size: 14px;
    }
  }
</style>
