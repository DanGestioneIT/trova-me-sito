---
import { path } from '../lib/paths';
import { altraLingua, cornice, type Lingua } from '../lib/lingue';

interface Props {
  lingua: Lingua;
  /** La stessa pagina nell'altra lingua: se c'e', la testata la offre. */
  altra?: string;
}

const { lingua, altra } = Astro.props;
const parole = cornice[lingua];
const altraParole = cornice[altraLingua(lingua)];

// Una sola app nella testata dal 25 novembre 2026: Pronto e' «in lavorazione» e ha
// solo un accenno nella pagina iniziale, senza pagina sua (decisione del proprietario).
const voci = [{ testo: 'Minta', href: path(parole.pathMinta) }];
---

<header>
  <div class="contenitore barra">
    <a class="marchio" href={path(parole.pathHome)}>TROVA<span class="punto">.</span>ME</a>
    <nav aria-label={parole.navigazione}>
      {voci.map((voce) => (
        <a href={voce.href}>{voce.testo}</a>
      ))}
      {altra !== undefined && (
        <a
          class="lingua"
          href={path(altra)}
          lang={altraLingua(lingua)}
          hreflang={altraLingua(lingua)}
        >{altraParole.nomeLingua}</a>
      )}
    </nav>
  </div>
</header>

<style>
  /* Non appiccicata: e' una vetrina breve, non un'applicazione. Su telefono
     una barra fissa ruba lo spazio che serve al contenuto. */
  header {
    border-bottom: 1px solid var(--bordo);
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }

  .marchio {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--testo);
    text-decoration: none;
    white-space: nowrap;
  }

  .punto {
    color: var(--accento);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  nav a {
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 15px;
    color: var(--tenue);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--testo);
    background: var(--superficie);
  }

  /* L'altra lingua: un bottone leggero, distinto dalle voci del sito. */
  nav .lingua {
    margin-left: 6px;
    border: 1px solid var(--bordo);
  }

  @media (max-width: 26rem) {
    nav a {
      padding: 8px 8px;
      font-size: 14px;
    }
  }
</style>
