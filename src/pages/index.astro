---
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';

// Una riga sola per app: il resto lo racconta la scheda.
// ClaudePal dichiara di essere un esperimento, perche' lo e'.
// Pronto suggerisce e non decide: attribuirle una decisione sarebbe falso.
const app = [
  {
    nome: 'Minta',
    riga: 'Speak, and get back a finished piece of writing.',
    href: path('app/minta/'),
  },
  {
    nome: 'Pronto',
    riga: 'Say what you have to do, and it suggests where to start.',
    href: path('app/pronto/'),
  },
  {
    nome: 'ClaudePal',
    riga: 'An experiment: your phone as a voice remote for Claude Code on your Mac.',
    href: path('app/claudepal/'),
  },
];

// Lo stato reale, detto in fondo alla pagina e non solo dentro le schede: chi
// arriva da un link deve poterlo scoprire senza entrare da nessuna parte.
// Il testo e' letterale, e un test fallisce se cambia.
const stato = 'None of these are on the App Store yet.';
---

<Base
  titolo="TROVA.ME — iPhone apps you use by talking, not typing"
  descrizione="I make three iPhone apps you use by talking, not typing. Speak, and something useful happens — none of them are on the App Store yet."
>
  <h1>I make iPhone apps you use by talking, not typing.</h1>
  <p>
    I publish three of them under the name TROVA.ME, and each turns something you say
    into something useful.
  </p>

  <ul class="elenco">
    {app.map((voce) => (
      <li>
        <a href={voce.href}>
          <strong>{voce.nome}</strong>
          <span>{voce.riga}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="stato">{stato}</p>
</Base>

<style>
  .elenco {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .elenco a {
    display: block;
    padding: 1rem;
    border: 1px solid var(--bordo);
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .elenco strong {
    display: block;
    color: var(--accento);
  }

  .elenco span {
    color: var(--testo-tenue);
  }

  .stato {
    /* Non e' un avviso da schivare: si legge, ma non compete con le tre app. */
    margin-top: 1.5rem;
    color: var(--testo-tenue);
  }
</style>
