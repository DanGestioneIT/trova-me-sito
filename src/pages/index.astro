---
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';

const app = [
  {
    nome: 'Minta',
    riga: 'Speak, and get back a finished piece of writing.',
    href: path('app/minta/'),
  },
  {
    nome: 'Pronto',
    riga: 'Say what you have to do. It decides where to start.',
    href: path('app/pronto/'),
  },
  {
    nome: 'ClaudePal',
    riga: 'Your phone as a remote control for your Mac. An experiment.',
    href: path('app/claudepal/'),
  },
];
---

<Base
  titolo="TROVA.ME — apps you use by talking"
  descrizione="Three iPhone apps that get the keyboard out of the way: you speak, and something useful happens."
>
  <h1>You speak. Something useful happens.</h1>
  <p>
    TROVA.ME is the name I publish my iPhone apps under. One idea holds them together:
    they get the keyboard out of the way.
  </p>

  <ul class="elenco">
    {app.map((voce) => (
      <li>
        <a href={voce.href}>
          <strong>{voce.nome}</strong>
          <span>{voce.riga}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .elenco {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .elenco a {
    display: block;
    padding: 1rem;
    border: 1px solid var(--bordo);
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .elenco strong {
    display: block;
    color: var(--accento);
  }

  .elenco span {
    color: var(--testo-tenue);
  }
</style>
