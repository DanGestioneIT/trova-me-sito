---
import Base from '../layouts/Base.astro';
import Firma from '../components/Firma.astro';
import { path } from '../lib/paths';

// Tre capitoli a tutta larghezza, non tre schede: ognuno prende il suo campo
// di colore e il nome diventa un'immagine. Non avendo screenshot, l'unica
// materia visiva onesta e' la tipografia portata alla scala di un manifesto.
const app = [
  {
    nome: 'Minta',
    riga: 'Speak, and get back a finished piece of writing.',
    href: path('app/minta/'),
    campo: '',
  },
  {
    nome: 'Pronto',
    riga: 'Say what you have to do, and it suggests where to start.',
    href: path('app/pronto/'),
    campo: 'campo-segnale',
  },
  {
    nome: 'ClaudePal',
    riga: 'An experiment: your phone as a voice remote for Claude Code on your Mac.',
    href: path('app/claudepal/'),
    campo: 'campo-inchiostro',
  },
];

// Lo stato reale, detto in fondo alla pagina e non solo dentro le schede: chi
// arriva da un link deve poterlo scoprire senza entrare da nessuna parte.
// Il testo e' letterale, e un test fallisce se cambia.
const stato = 'None of these are on the App Store yet.';
---

<Base
  titolo="TROVA.ME — iPhone apps you use by talking, not typing"
  descrizione="I make three iPhone apps you use by talking, not typing. Speak, and something useful happens — none of them are on the App Store yet."
>
  <h1>I make iPhone apps you use by talking, not typing.</h1>

  <Firma
    scena
    detto="so the thing is i need to write that up and also call the accountant"
    ottenuto="A finished text. A list in order. A Claude Code session within reach."
  />

  {app.map((voce) => (
    <a class:list={['capitolo', 'pieno', voce.campo]} href={voce.href}>
      <span class="dentro">
        <span class="nome">{voce.nome}</span>
        <span class="riga">{voce.riga}</span>
      </span>
    </a>
  ))}

  <p class="stato">{stato}</p>
</Base>

<style>
  .capitolo {
    display: block;
    padding: 56px var(--margine);
    border-top: 2px solid var(--inchiostro);
    color: inherit;
    text-decoration: none;
  }

  .capitolo.campo-segnale,
  .capitolo.campo-inchiostro {
    border-top-color: transparent;
  }

  .nome {
    display: block;
    /* Il nome esce dalla colonna e diventa la figura della pagina. */
    font-size: clamp(2.75rem, 15vw, 11rem);
    line-height: 0.85;
    font-weight: 900;
    letter-spacing: -0.055em;
  }

  .riga {
    display: block;
    max-width: 30ch;
    margin-top: 20px;
    font-size: clamp(1rem, 2.6vw, 1.375rem);
    line-height: 1.35;
  }

  .dentro {
    display: block;
    max-width: var(--contenuto);
    margin-inline: auto;
  }

  .capitolo:hover .nome,
  .capitolo:focus-visible .nome {
    font-style: oblique 6deg;
  }

  .stato {
    margin-top: 64px;
  }
</style>
