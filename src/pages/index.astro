---
import Base from '../layouts/Base.astro';
import Firma from '../components/Firma.astro';
import { path } from '../lib/paths';

// Le tre app come tre capitoli consecutivi, non come tre schede in
// competizione: sono parti della stessa cosa, e la pagina deve farlo sentire
// prima ancora che il visitatore legga i nomi.
//
// Niente numerazione 01/02/03: implicherebbe un ordine da seguire, e qui non
// c'e' — si sceglie quella che serve, non si legge una sequenza.
const app = [
  {
    nome: 'Minta',
    riga: 'Speak, and get back a finished piece of writing.',
    href: path('app/minta/'),
  },
  {
    nome: 'Pronto',
    riga: 'Say what you have to do, and it suggests where to start.',
    href: path('app/pronto/'),
  },
  {
    nome: 'ClaudePal',
    riga: 'An experiment: your phone as a voice remote for Claude Code on your Mac.',
    href: path('app/claudepal/'),
  },
];

// Lo stato reale, detto in fondo alla pagina e non solo dentro le schede: chi
// arriva da un link deve poterlo scoprire senza entrare da nessuna parte.
// Il testo e' letterale, e un test fallisce se cambia.
const stato = 'None of these are on the App Store yet.';
---

<Base
  titolo="TROVA.ME — iPhone apps you use by talking, not typing"
  descrizione="I make three iPhone apps you use by talking, not typing. Speak, and something useful happens — none of them are on the App Store yet."
>
  <h1>I make iPhone apps you use by talking, not typing.</h1>

  <Firma
    detto="so the thing is i need to write that up and also call the accountant"
    ottenuto="A finished text. A list in order. A Claude Code session within reach."
  />

  <ul class="capitoli">
    {app.map((voce) => (
      <li>
        <a href={voce.href}>
          <span class="nome">{voce.nome}</span>
          <span class="riga">{voce.riga}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="stato">{stato}</p>
</Base>

<style>
  .capitoli {
    max-width: var(--colonna);
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    border-top: 1px solid var(--bordo);
  }

  .capitoli li {
    border-bottom: 1px solid var(--bordo);
  }

  /* Tutta la voce e' il bersaglio: su un telefono un pollice non mira a una
     parola di sette caratteri. */
  .capitoli a {
    display: block;
    padding: 20px 0;
    color: inherit;
    text-decoration: none;
  }

  .nome {
    display: block;
    font-size: 28px;
    line-height: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .riga {
    display: block;
    margin-top: 4px;
    color: var(--tenue);
  }

  .capitoli a:hover .nome {
    color: var(--accento);
  }
</style>
