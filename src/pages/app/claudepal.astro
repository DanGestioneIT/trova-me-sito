---
import Base from '../../layouts/Base.astro';
import SegnapostoSchermata from '../../components/SegnapostoSchermata.astro';
---

<Base
  titolo="ClaudePal — your phone as a remote control | TROVA.ME"
  descrizione="ClaudePal is an experiment: drive a Claude Code session on your Mac by talking to your phone."
>
  <h1>ClaudePal</h1>
  <p class="stato">An experiment, not a release</p>
  <p>
    Drive a Claude Code session running on your Mac by talking to your phone, and read the
    answer there. This is a declared experiment — not a product on its way.
  </p>

  <SegnapostoSchermata app="ClaudePal" />
</Base>

<style>
  .stato {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--sfondo-tenue);
    color: var(--testo-tenue);
    font-size: 0.875rem;
  }
</style>
