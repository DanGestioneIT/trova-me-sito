---
import Base from '../../layouts/Base.astro';
import SegnapostoSchermata from '../../components/SegnapostoSchermata.astro';
---

<Base
  titolo="Pronto — the list that decides where to start | TROVA.ME"
  descrizione="Pronto is a to-do list that understands speech: say what you have to do, and it sorts it by priority and hands you the first concrete step."
>
  <h1>Pronto</h1>
  <p class="stato">Coming to the App Store</p>
  <p>
    Say what you have to do, in your own words. Pronto works out what you meant, sorts it
    by priority, and hands you the first concrete step.
  </p>
  <p>
    It is built for people who put things off. It is not one more list — it is a list that
    decides where to start for you.
  </p>

  <SegnapostoSchermata app="Pronto" />
</Base>

<style>
  .stato {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--sfondo-tenue);
    color: var(--testo-tenue);
    font-size: 0.875rem;
  }
</style>
