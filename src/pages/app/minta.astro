---
import Base from '../../layouts/Base.astro';
import Firma from '../../components/Firma.astro';
import SegnapostoSchermata from '../../components/SegnapostoSchermata.astro';
import { path } from '../../lib/paths';

// Riscritta il 27 ottobre 2026 su quello che l'app fa oggi. Ogni frase viene da
// tre fonti del progetto MintaApp, non da come l'app "dovrebbe" funzionare:
// Minta/CHANGELOG.md (fino al Lotto 75), i testi dello Store approvati
// (Documentation/APPSTORE-TESTI-DEFINITIVI-2026-10-25.md) e l'informativa
// (Documentation/INFORMATIVA-PRIVACY-BOZZA.md). Se l'app cambia formati, limiti o
// motori, si rilegge qui.
//
// I due motori, nell'ordine in cui li si incontra nel foglio «Elabora»: prima il
// gratuito, poi il credito. Il gratuito: la trascrizione sul telefono (Lotto 75),
// il riassunto generico e sei formati in piu' su Apple Private Cloud Compute con
// iOS 27 (Lotti 36 e 69), fino a circa un'ora di parlato (10.000 parole, Lotto 54);
// senza rete il telefono da solo scrive il riassunto, circa 40 minuti su iOS 27 e 20
// su iOS 26 (Lotto 68: qui solo «shorter recordings»). Minta Cloud:
// tutti i formati fino a 3 ore (Lotto 37), Whisper fino a 3 ore (Lotto 52).
const motori = [
  {
    titolo: 'Free, with Apple Intelligence',
    testo:
      'Transcription runs on your iPhone. Online with iOS 27, Apple Intelligence writes a general summary and six more formats on Apple’s Private Cloud Compute, which keeps nothing, for up to about an hour of speech. Offline, the phone writes the summary on its own, for shorter recordings.',
  },
  {
    titolo: 'Minta Cloud',
    testo:
      'Anthropic’s AI writes every format, for recordings up to 3 hours. For a noisy room, Whisper can transcribe on the server. Pay as you go, no subscription; new accounts get a free trial. The server transcribes and writes up without storing anything: the result waits in memory for at most 15 minutes, only so your iPhone can collect it.',
  },
];

// Le funzioni che contano, una riga ciascuna. Tutte nei testi dello Store, tranne
// la lingua dell'elaborato (Lotto 66) e la nota «scritto dall'AI» (Lotto 59).
const punti = [
  'Record up to 3 hours, even with the screen locked. Start from the Action button, Control Center or Siri.',
  'Knows who said what (iOS 27): name the voices, and the minutes use the names.',
  'Tap a paragraph to hear that moment again.',
  'Group recordings into a series — a project, a course, a client — and Minta tells you what was decided, what has changed and what is still open.',
  'Get the write-up in a different language from the recording.',
  'Export as PDF or Word. Sync with your own iCloud, with your texts encrypted.',
  'Every write-up opens with a note that AI wrote it: check it before you use it.',
];

// Lo stato reale dell'app, detto prima di qualunque descrizione: chi legge
// deve saperlo subito, non alla fine. Un test fallisce se questa riga cambia.
const stato = 'In testing — not on the App Store yet.';
---

<Base
  titolo="Minta — speak, and get back something you can send | TROVA.ME"
  descrizione="Minta records a meeting, a lecture or an idea, transcribes it on your iPhone, and turns it into minutes, study notes or a summary ready to send."
>
  <div class="contenitore">
    <div class="testata">
      <h1>Speak. Get back something you can send.</h1>
      <p class="stato">{stato}</p>
      <p class="apertura">
        Record a meeting, a lecture, an interview or a quick idea. Minta transcribes it on your
        iPhone and turns it into the text you actually needed: minutes with decisions and tasks,
        notes for the exam, a summary to send to the client.
      </p>
      <div class="firma-scheda">
        <Firma
          detto="we agreed to send the revised quote and confirm the schedule"
          ottenuto="Next steps: send the revised quote; confirm the schedule."
        />
      </div>
    </div>

    <section class="sezione">
      <h2>Free, or Minta Cloud. You choose each time.</h2>
      <p class="premessa">
        Your recordings stay on your iPhone. Nothing goes to Minta Cloud without your yes.
      </p>
      <div class="motori">
        {motori.map((motore) => (
          <div class="motore">
            <h3>{motore.titolo}</h3>
            <p>{motore.testo}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="sezione">
      <h2>A format for each kind of recording.</h2>
      <p>
        A meeting becomes minutes with decisions, tasks and owners, or a summary you read in a
        minute. A lecture becomes study notes, formulas included.
      </p>
      <p>
        There are formats for client meetings, a lawyer or an accountant, job interviews, site
        inspections, condominium meetings, interviews and podcasts, brainstorms, a journal, a
        recipe. Minta suggests the one that fits, and two formats are yours to write.
      </p>
    </section>

    <section class="sezione">
      <h2>Made for long, real recordings.</h2>
      <ul class="punti">
        {punti.map((punto) => <li>{punto}</li>)}
      </ul>
    </section>

    <SegnapostoSchermata app="Minta" />

    {/* L'app apre la stessa pagina da Impostazioni › Info › Support. */}
    <p class="aiuto">
      Using Minta and need a hand? <a href={path('app/minta/support/')}>Minta support</a>
    </p>
  </div>
</Base>

<style>
  .testata {
    padding: 48px 0 0;
  }

  .firma-scheda {
    max-width: 640px;
    margin-top: 28px;
  }

  .premessa {
    margin-top: 0;
  }

  /* Righe, non schede: la scheda resta solo alla trasformazione Said/Became,
     che e' l'unica cosa che merita di stare sollevata dalla pagina. */
  .motori {
    margin-top: 4px;
    border-top: 1px solid var(--bordo);
  }

  .motore {
    padding: 20px 0;
    border-bottom: 1px solid var(--bordo);
  }

  .motore p {
    margin: 0;
    color: var(--tenue);
  }

  /* Le stesse righe dei motori, piu' leggere: un fatto per riga, niente pallini. */
  .punti {
    max-width: var(--lettura);
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--bordo);
  }

  .punti li {
    padding: 14px 0;
    border-bottom: 1px solid var(--bordo);
    color: var(--tenue);
  }

  .aiuto {
    margin: 40px 0 0;
    color: var(--tenue);
  }

  @media (min-width: 48rem) {
    .testata {
      padding-top: 72px;
    }

    .motore {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 32px;
      align-items: baseline;
    }
  }
</style>
