---
import Base from '../../layouts/Base.astro';
import SegnapostoSchermata from '../../components/SegnapostoSchermata.astro';
---

<Base
  titolo="Minta — record, transcribe, rewrite | TROVA.ME"
  descrizione="Minta records your voice, transcribes it and rewrites it, with a prompt tuned to the situation you are in."
>
  <h1>Minta</h1>
  <p class="stato">Coming to the App Store</p>
  <p>
    Record, transcribe, rewrite. You speak, and you get back a finished piece of writing —
    shaped by a prompt tuned to the situation you are in.
  </p>

  <SegnapostoSchermata app="Minta" />
</Base>

<style>
  .stato {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--sfondo-tenue);
    color: var(--testo-tenue);
    font-size: 0.875rem;
  }
</style>
