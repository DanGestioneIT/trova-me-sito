---
// Pagina di errore del sito. Il nome del file non e' negoziabile: GitHub Pages
// serve `404.html` dalla radice del sito pubblicato, e Astro produce quel file
// solo da `src/pages/404.astro`.
//
// Chi ci arriva ha gia' sbagliato strada: la pagina dice cosa e' successo e da'
// una sola via d'uscita, senza altro contenuto intorno.
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';
---

<Base
  titolo="Page not found — TROVA.ME"
  descrizione="The page you're looking for doesn't exist."
  nonIndicizzare
>
  <h1>Page not found</h1>
  <p>The page you're looking for doesn't exist.</p>
  <a class="ritorno" href={path('')}>Go to the homepage</a>
</Base>

<style>
  h1 {
    /* Un manifesto: chi e' finito qui deve capire in un colpo d'occhio, da
       lontano, che ha sbagliato strada. */
    font-size: clamp(3.5rem, 18vw, 12rem);
    margin-top: 12vh;
  }

  .ritorno {
    /* 44 px e' il bersaglio minimo che un pollice colpisce al primo tentativo:
       chi e' finito qui per sbaglio non deve sbagliare anche l'uscita. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 32px;
    padding: 16px 32px;
    background: var(--segnale);
    color: var(--su-segnale);
    font-weight: 700;
    font-weight: 600;
    text-decoration: none;
  }

  .ritorno:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
